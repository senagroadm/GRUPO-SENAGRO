# ==============================================================================
# NEXUS ERP - Environment Configuration Template
# ==============================================================================
# Duplicate this file to .env, .env.staging or .env.production and configure.
# NEVER commit real production credentials to Git or public repositories.

# Application Runtime (development | staging | production | test)
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_VERSION=v1

# Security & CORS Origins (Comma-separated override for allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL / Supabase Database Configuration
# Local format: postgresql://nexus_user:nexus_password@localhost:5432/nexus_erp
# Supabase format: postgresql://postgres:[YOUR-PASSWORD]@db.jaagiioxpnbawfmoxoih.supabase.co:5432/postgres
DATABASE_URL=postgresql://nexus_user:nexus_password@localhost:5432/nexus_erp
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
ENABLE_QUERY_LOGS=false

# Authentication & JWT (Must be >= 32 chars in production)
JWT_SECRET=change_me_to_a_secure_random_string_at_least_32_chars_long
JWT_EXPIRES_IN=8h

# Logging & Telemetry (debug | info | warn | error)
LOG_LEVEL=info

# External Service Gateways (To be configured per environment)
FISCAL_PROVIDER_API_KEY=
FISCAL_CERTIFICATE_PASSWORD=
SERASA_API_CLIENT_ID=
SERASA_API_CLIENT_SECRET=
STORAGE_BUCKET_NAME=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Google AI Studio / Gemini Integration (Server-side only)
GEMINI_API_KEY=
